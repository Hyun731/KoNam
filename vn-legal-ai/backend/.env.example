DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5432/legal
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# 추론 강도: 챗봇은 low(교차 참조 정확도), 문서 분석·질의 재작성은 minimal(속도)
OPENAI_REASONING_EFFORT=low
OPENAI_ANALYSIS_REASONING_EFFORT=minimal
OPENAI_FAST_REASONING_EFFORT=minimal
# none | cross-encoder (pip install -e ".[rerank]" 필요)
RERANKER=none
# 개발 초기에 샘플 법령(data/laws/_*)으로 확인할 때만 true
INCLUDE_SAMPLES=false
# 개발용 가짜 응답 (API 키 없이 화면 확인). 시연·운영에서는 false
LLM_FAKE=false
